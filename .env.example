PORT=3000
# Sign-in (README, "Sign-in"). Leave all three empty to run open on this computer only.
DEMO_MODE=
ADMIN_PASSWORD=
SESSION_SECRET=
# Set to false to skip preloading the first charts and images at start and at sign-in.
WARM_UP=
DB_BACKEND=sqlite
SQLITE_FILE=data/app.sqlite
DATABASE_URL=
OBJECT_STORE=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CAPTURE_KEY=
CAPTURE_KEY_FILE=data/capture.key
HL7_MLLP_PORT=
HL7_OUT_URL=
HL7_ORDER_MESSAGE=ORM
ALLOW_EXTERNAL_MODELS=
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
HTTP_JSON_MODEL_URL=
HTTP_JSON_MODEL_KEY=
HTTP_JSON_MODEL_NAME=
ALLOW_EXTERNAL_CDS=
# Whole-slide images: where slide files are stored, and whether embedded label/macro images may be shown (synthetic patients only).
SLIDES_DIR=
SHOW_SLIDE_LABELS=

# Bring your own model (docs/BRING-YOUR-OWN-AGENT.md). A local endpoint needs nothing here.
# Cloud endpoints need ALLOW_EXTERNAL_MODELS=true and a key, named when the agent is added.
GOOGLE_API_KEY=
# Optional check of a local model through the reference harness (scripts/local-model-check.mjs).
LOCAL_MODEL_URL=
LOCAL_MODEL_NAME=
